# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js — rooted rules cover Loom only; the reader app is a second Next app
# with its own build output, node_modules and lockfile (LOOM-130).
/.next/
/out/
/reader/.next/
/reader/.next-stale-*/
/reader/out/
/reader/node_modules/
# Generated mirror of shared/ — regenerated on every reader dev/build.
/reader/src/shared/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# database
*.db
# SQLite sidecars. `*.db` does NOT match these — a live connection leaves a
# -wal that can reach hundreds of MB, and it shows up as untracked at exactly
# the moment someone is most likely to `git add -A` without looking (LOOM-125).
*.db-wal
*.db-shm

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
.claude/
.superpowers/

# user
/public/characters
/public/covers
/public/music
/public/narration
/public/avatar.jpg
/data

# Reader tier assets (LOOM-124). The rules above are ROOTED, so they do not
# reach the reader app's own public/ — published covers, portraits and
# narration audio copied there by the publish step would otherwise be staged
# for commit. Same media, same reason, different root.
/reader/public/characters
/reader/public/covers
/reader/public/music
/reader/public/narration
# Sandbox publishes namespace their outputs so a fixture run cannot clobber
# the snapshot real readers are served.
/reader/public-sandbox/
# local pre-migration database snapshots — never commit (large binaries)
dev.db.pre-*

# compiled native helpers (built on demand by scripts/ensure-narrate.mjs)
/scripts/native/bin

.claude/*
graphify-out/*

# Python bytecode — ops/ is the only Python in this repo (LOOM-23)
__pycache__/
*.pyc
