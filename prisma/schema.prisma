generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Series {
  id          String          @id @default(cuid())
  title       String
  description String          @default("")
  // JSON-encoded arrays. SQLite has no native list type; this matches the
  // pattern used for setsVariables. Empty array ("[]") means "untagged".
  // Genres come from a fixed list in src/lib/genres.ts; keywords are
  // free-form text tags. Both are series-level — books inherit them on
  // the public landing pages.
  genres      String          @default("[]")
  keywords    String          @default("[]")
  // True when the author created this as a stand-alone book rather than
  // a series. Persisted so the writer's list and reader's Explore can
  // present it differently down the road (single-book card, route the
  // author straight to the book editor instead of the series outline).
  // The underlying data model stays a Series-with-one-Book either way.
  standalone  Boolean         @default(false)
  // Demo data flag — set by /api/seed/demo and used by the matching
  // DELETE to clean up everything generated for "see how Explore feels
  // with N series" testing. Real series stay at the default false.
  demo        Boolean         @default(false)
  // Override the global profile name on a per-series basis. Used by the
  // demo seed to attribute fake series to fake authors so the writer can
  // browse Explore "as a reader" without seeing their own pseudonym
  // every card. Null on real series — those fall back to the profile.
  authorOverrideName String?
  createdAt   DateTime        @default(now())
  books       Book[]
  variables   StoryVariable[]
  sessions    ReaderSession[]
  characters  Character[]
  // Loom's per-book overlay on WriteAI's characters. Replaces `characters`,
  // which goes away with the Character model in LOOM-90.
  writerCharacters WriterCharacterMeta[]
}

model Character {
  id          String                  @id @default(cuid())
  seriesId    String
  name        String
  age         Int?
  firstBookId String?
  // The book in which this character dies. They appear normally in this book
  // and every earlier book; in later books they're flagged "Deceased" but
  // remain referenceable (so flashbacks / eulogies still resolve marks).
  deathBookId String?
  // The last book the character appears in. In every book past lastBookId
  // they're hidden from the reader's cast list. Unlike deathBookId this
  // doesn't imply death — useful for side characters who fade from the
  // story. The author still sees them in their own book grids with a
  // "Hidden in this book" indicator.
  lastBookId  String?
  // Primary character marker. Surfaced as a small star on the author and
  // reader cast grids. Not gated per book — once primary, always primary.
  starred     Boolean                 @default(false)
  series      Series                  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  firstBook   Book?                   @relation("FirstAppearsIn", fields: [firstBookId], references: [id], onDelete: SetNull)
  deathBook   Book?                   @relation("DiesIn", fields: [deathBookId], references: [id], onDelete: SetNull)
  lastBook    Book?                   @relation("LastAppearsIn", fields: [lastBookId], references: [id], onDelete: SetNull)
  overrides   CharacterBookOverride[]

  @@index([seriesId])
  @@index([firstBookId])
  @@index([deathBookId])
  @@index([lastBookId])
}

model CharacterBookOverride {
  id          String    @id @default(cuid())
  characterId String
  bookId      String
  age         Int?
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  book        Book      @relation("CharacterOverrides", fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([characterId, bookId])
  @@index([bookId])
}

// Loom's half of a WriteAI writer-character (LOOM-85, under LOOM-5).
//
// WriteAI owns who a character IS — name, category, aliases, traits, goals,
// relationships, the default portrait. It has no concept of a book, so it has
// nowhere to put the things below, every one of which is per-book narrative
// state the reader's cast list is built out of. Those stay here, keyed by the
// `wc-` id.
//
// Do not solve this by adding fields to WriteAI's record instead:
// `PUT /api/plan/characters/{id}` stores the body verbatim with no model, so a
// write that forgets a key deletes it. Loom's book knowledge does not belong
// in a record Loom cannot safely round-trip.
//
// `writerCharacterId` is a plain string, not a foreign key — the referent
// lives in another process. Same choice, for the same reason, as
// ChapterCharacter and ChapterEvent. The book links ARE real relations,
// because books are Loom's.
model WriterCharacterMeta {
  id                String                    @id @default(cuid())
  seriesId          String
  // "wc-<hex>" — WriteAI's id. No FK; see above.
  writerCharacterId String
  age               Int?
  // Primary character marker. Not gated per book — once primary, always
  // primary. Carried over from Character.starred.
  starred           Boolean                   @default(false)
  // The book this character first appears in. Books before it hide them from
  // the cast list entirely.
  firstBookId       String?
  // The book in which this character dies. They appear normally in this book
  // and every earlier one; in later books they're flagged "Deceased" but stay
  // referenceable, so flashbacks and eulogies still resolve.
  deathBookId       String?
  // The last book the character appears in. Past it they're hidden from the
  // reader's cast list — unlike deathBookId this doesn't imply death.
  lastBookId        String?
  series            Series                    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  firstBook         Book?                     @relation("WriterCharacterFirstAppearsIn", fields: [firstBookId], references: [id], onDelete: SetNull)
  deathBook         Book?                     @relation("WriterCharacterDiesIn", fields: [deathBookId], references: [id], onDelete: SetNull)
  lastBook          Book?                     @relation("WriterCharacterLastAppearsIn", fields: [lastBookId], references: [id], onDelete: SetNull)
  bookMeta          WriterCharacterBookMeta[]

  @@unique([seriesId, writerCharacterId])
  @@index([firstBookId])
  @@index([deathBookId])
  @@index([lastBookId])
}

// Per-book overrides on the above. Currently age only; the per-book PORTRAIT
// is a file on disk (`<wc-id>-<bookId>.jpg`), not a column — see LOOM-87.
//
// Unlike its predecessor this hangs off the meta row rather than repeating the
// `wc-` id, so deleting a character's Loom overlay takes its per-book rows with
// it instead of orphaning them.
model WriterCharacterBookMeta {
  id       String              @id @default(cuid())
  metaId   String
  bookId   String
  age      Int?
  meta     WriterCharacterMeta @relation(fields: [metaId], references: [id], onDelete: Cascade)
  book     Book                @relation("WriterCharacterBookOverrides", fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([metaId, bookId])
  @@index([bookId])
}

// A local copy of WriteAI's writer-character pool (LOOM-86, under LOOM-5).
//
// ⚠️ This is a CACHE. WriteAI's `writer_characters.json` is the source of
// truth for every column here, and a stale or damaged snapshot is repaired by
// re-running the refresh — there is deliberately nothing in this table that
// exists nowhere else. Keep it that way: Loom-owned character data goes in
// WriterCharacterMeta, not here.
//
// It exists because `GET /api/plan/characters` WRITES TO DISK — it seeds from
// canon, prunes entries canon reclassifies, and rewrites `books` from numbers
// to names, saving whenever any of that changes. Reader and preview pages
// render a cast list on every visit; rendering must not mutate another app's
// data file. Availability is not the argument (both apps are local) — that is.
//
// List-shaped fields are JSON strings, matching Series.genres and the rest of
// the schema. SQLite has no native list type.
model WriterCharacterSnapshot {
  // WriteAI's id IS the primary key — there is no Loom-side identity for a
  // row that is purely a copy. Mostly "wc-<hex>", but at least one live record
  // predates that convention ("draft-<ms>"), so nothing here assumes a shape.
  writerCharacterId String   @id
  name              String
  category          String?
  role              String?
  // One comma-separated string, not a list — WriteAI's shape, preserved.
  aliases           String?
  traits            String   @default("[]")
  arcNotes          String?
  goals             String?
  // JSON [{ target: "<wc-id>", nature: "..." }]. Targets are ids, not names.
  relationships     String   @default("[]")
  // JSON array of book TITLES (WriteAI's own shape — not Loom book ids).
  books             String   @default("[]")
  photoUrl          String?
  syncedAt          DateTime @updatedAt
}

model Book {
  id                           String                  @id @default(cuid())
  seriesId                     String
  title                        String
  synopsis                     String                  @default("")
  coverPath                    String?
  order                        Int
  // Publish gate for public preview pages. Drafts still appear in the
  // series landing's book list but with a "Coming Soon" treatment instead
  // of a link; the book landing disables its Start Reading CTA. New books
  // start as drafts; the migration backfills existing books to published.
  published                    Boolean                 @default(false)
  // "I'm currently writing this book." When set, the writer's series
  // outline defaults to opening this book and scrolling its last chapter
  // into view, instead of always opening book 1. Only one book per series
  // should be in progress at a time — enforced in the PATCH endpoint by
  // clearing the flag on every other book in the same series.
  inProgress                   Boolean                 @default(false)
  series                       Series                  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  chapters                     Chapter[]
  charactersFirstAppearingHere Character[]             @relation("FirstAppearsIn")
  charactersDyingHere          Character[]             @relation("DiesIn")
  charactersLastAppearingHere  Character[]             @relation("LastAppearsIn")
  characterOverrides           CharacterBookOverride[] @relation("CharacterOverrides")
  // The writer-character equivalents of the four above. Both sets coexist
  // until LOOM-90 retires the Character model.
  writerCharactersFirstAppearingHere WriterCharacterMeta[]     @relation("WriterCharacterFirstAppearsIn")
  writerCharactersDyingHere          WriterCharacterMeta[]     @relation("WriterCharacterDiesIn")
  writerCharactersLastAppearingHere  WriterCharacterMeta[]     @relation("WriterCharacterLastAppearsIn")
  writerCharacterOverrides           WriterCharacterBookMeta[] @relation("WriterCharacterBookOverrides")
  // Inverse of StoryVariable.originBook — set when this book is the
  // origin for a variable.
  originatingVariables         StoryVariable[]

  @@index([seriesId, order])
}

model Chapter {
  id             String         @id @default(cuid())
  bookId         String
  title          String
  order          Int
  pov            String?
  date           String?
  condition      String?
  numbered       Boolean        @default(true)
  book           Book           @relation(fields: [bookId], references: [id], onDelete: Cascade)
  blocks         ContentBlock[]
  inboundChoices Choice[]       @relation("TargetChapter")
  narrations     ChapterNarration[]
  note           ChapterNote?
  summary        ChapterSummary?
  events         ChapterEvent[]
  characters     ChapterCharacter[]

  @@index([bookId, order])
}

// A writer-authored summary for a chapter WriteAI cannot describe (LOOM-120).
//
// Every canon chapter gets its summary from WriteAI's outline card, machine-
// written and refreshed by enrichment. Branch-gated chapters get nothing: the
// canon walk never reaches them, so they never enter the manifest, so no card
// is ever seeded — and one added by hand is PRUNED by `_auto_reconcile`, which
// drops any card whose loom_id is absent from the manifest. The Chapters tab
// shows those chapters in sequence, so it needs somewhere to put a summary,
// and WriteAI's store is provably not it.
//
// Deliberately NOT ChapterNote. That is the writer's private scratchpad —
// continuity reminders, threads to fix — and it never renders to readers. A
// summary describes what happens and is shown on a card. Folding the two would
// mean either notes leaking onto the board or summaries buried in a field the
// board does not read.
//
// A separate table rather than a column on Chapter, for the reason ChapterNote
// records: chapter rows are fetched in bulk for the outline tree and the book
// page, and Prisma selects every scalar by default, so a summary body on
// Chapter would ride along in every one of those list queries.
model ChapterSummary {
  id        String   @id @default(cuid())
  chapterId String   @unique
  body      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
}

// The writer's private scratchpad for one chapter — continuity reminders,
// threads to fix, questions to answer. Deliberately plain text, not prose: it
// never renders to readers, never exports, and find & replace never touches it
// (that pipeline only walks ContentBlock).
//
// A separate table rather than a column on Chapter because chapter rows are
// fetched in bulk for the outline tree and the book page, and Prisma selects
// every scalar by default — a note body on Chapter would ride along in each of
// those list queries for no reason.
model ChapterNote {
  id        String   @id @default(cuid())
  chapterId String   @unique
  body      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
}

// A WriteAI writer-event referenced in this chapter (LOOM-32).
//
// Events themselves live in WriteAI (writer_data/writer_events.json); this
// table holds ONLY the id. Nothing about the event — title, date, characters —
// is copied here, so there is no second source of truth to drift and no sync
// to keep running. It is a foreign key across the app boundary, not a mirror.
//
// The point of the table is that it is keyed by chapter *cuid*. WriteAI used to
// tag chapters as {book title, chapter number}, both of which move: inserting a
// chapter renumbered every tag in the book, silently. Loom already renumbers
// chapters on insert, so a cuid-keyed tag simply follows its chapter.
//
// An id that no longer resolves (the event was deleted in WriteAI) is treated
// as unknown identity — hidden from the UI, never auto-deleted. Same
// degradation contract as the rest of the seam; see INTEGRATION.md.
model ChapterEvent {
  id            String   @id @default(cuid())
  chapterId     String
  writerEventId String
  createdAt     DateTime @default(now())
  // This event is referenced in this chapter only on a NON-CANON branch —
  // behind a choice point, a conditional fragment, or an override (LOOM-78).
  // The sibling of ChapterCharacter.nonCanon, for the same reasons: the flag
  // belongs on the TAG, because non-canon in Loom is a path THROUGH an
  // otherwise canon chapter, so the same event can be canon in chapter 4 and
  // branch-only in chapter 7.
  //
  // `/api/chapter-events` — the one route WriteAI reads — filters these out.
  // Note this hides the TAG, not the event: the event itself still lives in
  // WriteAI's writer_events.json and still appears on its timeline, just
  // without a chapter link claiming it as canon here.
  nonCanon      Boolean  @default(false)
  chapter       Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  // Tagging the same event twice is a no-op, not an error — the API relies on
  // this to make POST idempotent rather than checking first and racing.
  @@unique([chapterId, writerEventId])
  // Answers "which OTHER chapters is this event tagged in?" — the sidebar's
  // "also in Ch. 7", which is the whole reason to look at the tab.
  @@index([writerEventId])
}

// A WriteAI writer-character who appears in this chapter (LOOM-33).
//
// The sibling of ChapterEvent, and for the same reason: WriteAI can only say
// which BOOKS a character is in (`books`, matched by title), never which
// chapters. Keyed by chapter cuid, so a tag follows its chapter through
// insertion and renumbering.
//
// Stores the `wc-` id and nothing else. Deliberately NOT the name: names are
// what WriteAI itself still references in a few places, and renaming a
// character there silently orphans them (LOOM-45). Loom does not repeat that.
//
// An id that no longer resolves is unknown identity — hidden, never
// auto-deleted. Note WriteAI's GET /api/plan/characters PRUNES auto-seeded
// entries it has reclassified, so this happens in ordinary use, not just when
// a character is deliberately deleted.
model ChapterCharacter {
  id                String   @id @default(cuid())
  chapterId         String
  writerCharacterId String
  createdAt         DateTime @default(now())
  // This character appears in this chapter only on a NON-CANON branch —
  // behind a choice point, a conditional fragment, or an override (LOOM-63).
  //
  // The flag belongs on the TAG, not on the character and not on the chapter:
  // non-canon in Loom is a path THROUGH an otherwise canon chapter, so the
  // same character can be canon in chapter 4 and branch-only in chapter 7.
  //
  // Load-bearing for the app boundary. WriteAI holds canon data only, so
  // `/api/chapter-characters` — the one route WriteAI reads — filters these
  // out. Loom stays the only app that knows the CYOA story exists.
  nonCanon          Boolean  @default(false)
  chapter           Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  // Tagging the same character twice is a no-op, not an error — the API
  // relies on this to make POST idempotent rather than checking first.
  @@unique([chapterId, writerCharacterId])
  // Answers "which OTHER chapters is this character in?" — the expanded
  // card's appearance list.
  @@index([writerCharacterId])
}

// Cached text-to-speech narration for one *variant* of a chapter — a specific
// sequence of unlocked segments (see NarrationSegment). A chapter has many
// variants because answering a gating choice unlocks more prose: the default
// (pre-choice) variant, then a longer one per branch the reader takes. Keyed by
// (chapterId, contentHash) where contentHash fingerprints that segment sequence
// + voice, so a chapter edit or a newly-unlocked branch is simply a new row and
// both the nightly cron and the read-mode trigger know when to regenerate.
// `audioPath` is the concatenated audio on disk (or, for a single-segment
// variant, the shared segment clip itself); `timing` is the combined word-timing
// map; `durationMs` the combined duration.
model ChapterNarration {
  id          String   @id @default(cuid())
  chapterId   String
  voice       String
  audioPath   String
  timing      String
  contentHash String
  durationMs  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  chapter     Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, contentHash])
  @@index([chapterId])
}

// Content-addressed cache of one narration "segment" — a run of spoken prose
// between choice points, keyed by the hash of its exact text + voice. A chapter's
// current audio is the concatenation of its unlocked segments; caching per
// segment means answering a choice only synthesizes the newly-unlocked chunk,
// and the shared pre-choice segment is reused across every branch. Not tied to a
// chapter, so identical text (e.g. the same intro under any branch) dedupes.
model NarrationSegment {
  hash       String   @id
  voice      String
  audioPath  String
  timing     String
  durationMs Int
  createdAt  DateTime @default(now())
}

model ContentBlock {
  id          String                @id @default(cuid())
  chapterId   String
  order       Int
  type        String
  content     String?
  prompt      String?
  displayType String?
  baseContent String?
  condition   String?
  pinStart    Int?
  pinEnd      Int?
  // Derived cache: words in content + baseContent + every override's
  // content, kept fresh by the write paths (block/override saves, replace,
  // import) so list/stat endpoints can aggregate without shipping prose.
  // Never a source of truth — scripts/backfill-word-counts.mjs recomputes
  // it from scratch if it ever drifts.
  wordCount   Int                   @default(0)
  chapter     Chapter               @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  choices     Choice[]
  overrides   ConditionalOverride[]

  @@index([chapterId, order])
}

model Choice {
  id              String       @id @default(cuid())
  choicePointId   String
  // Position within the choice point. Orders 0 and 1 are the two "base"
  // options every choice point is seeded with: they always render, can't
  // be gated, and can't be deleted — so a reader is never left with an
  // empty choice point no matter how the gated extras (order >= 2)
  // evaluate. Additional options are appended at max(order)+1.
  order           Int          @default(0)
  label           String
  setsVariables   String       @default("{}")
  // Optional per-option gate (same JSON grammar as ContentBlock.condition,
  // read by matchesCondition). Only meaningful for order >= 2 — the base
  // pair ignores it. Null / "{}" means the option always shows.
  condition       String?
  targetChapterId String?
  // Per-choice prose shown to the reader after they pick this option.
  // When `isBadEnding` is true, the text drives a Bad Ending modal and
  // truncates the rest of the chapter (the historical behavior of this
  // field). When false, the text renders inline at the choice-point's
  // position so writers can give each branch a one-paragraph
  // consequence without spinning up a one-off boolean variable.
  endingMessage   String?
  isBadEnding     Boolean      @default(false)
  // When true, picking this option cleanly ends the chapter: every block
  // after the choice point is dropped (reader, narration, canon export) and
  // the reader advances via the normal chapter footer. Unlike `isBadEnding`
  // there's no death modal or rewind — the story continues into the next
  // chapter. Used for branches whose consequences simply leave nothing more
  // to say in this chapter, so trailing blocks would otherwise each need a
  // guard condition. If both are set, `isBadEnding` wins.
  endsChapter     Boolean      @default(false)
  choicePoint     ContentBlock @relation(fields: [choicePointId], references: [id], onDelete: Cascade)
  targetChapter   Chapter?     @relation("TargetChapter", fields: [targetChapterId], references: [id])

  @@index([choicePointId])
  @@index([targetChapterId])
}

model ConditionalOverride {
  id                    String       @id @default(cuid())
  conditionalFragmentId String
  order                 Int
  condition             String       @default("{}")
  content               String
  // When set, this override fires a Bad Ending modal instead of rendering
  // `content` inline. Lets the writer end a run from the culmination of
  // several earlier choices aligning, rather than a single fatal choice.
  endingMessage         String?
  // When true, a matched override cleanly ends the chapter: its `content`
  // renders, then every block after this fragment is dropped (reader,
  // narration, canon export) and the reader advances via the normal chapter
  // footer. Unlike `endingMessage` there's no death modal or rewind — the
  // story continues into the next chapter. This is the "the scenario is over,
  // stop here" marker that saves guarding every trailing block. If both are
  // set, `endingMessage` (bad ending) wins.
  endsChapter           Boolean      @default(false)
  conditionalFragment   ContentBlock @relation(fields: [conditionalFragmentId], references: [id], onDelete: Cascade)

  @@index([conditionalFragmentId, order])
}

model StoryVariable {
  id           String @id @default(cuid())
  seriesId     String
  name         String
  type         String
  defaultValue String @default("null")
  // Book this variable "originated from" — used for the Context modal's
  // Origin column so the writer can see where a variable was first
  // needed. Stamped on the book the writer was on when they created it
  // (new flow), backfilled for existing rows from the earliest book in
  // series order that references the variable. Stays null when nothing
  // references the variable yet. SetNull on book delete so a deleted
  // book doesn't cascade through to the variable.
  originBookId String?
  series       Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  originBook   Book?  @relation(fields: [originBookId], references: [id], onDelete: SetNull)

  @@unique([seriesId, name])
  @@index([originBookId])
}

model ReaderSession {
  id             String   @id @default(cuid())
  seriesId       String
  createdAt      DateTime @default(now())
  // Auto-touched on every choice, rewind, or session PATCH so the
  // reader-side Continue Reading row can sort by "most recently
  // opened" without us tracking activity by hand.
  updatedAt      DateTime @updatedAt
  currentBlockId String?
  storyState     String   @default("{}")
  choiceHistory  String   @default("[]")
  series         Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@index([seriesId])
  @@index([updatedAt])
}
